#!/bin/bash

# exe final dir
bdir="build"
edir="executables"
pdir="../"

# Commands
cmd="cd $bdir"
run="cmake $pdir"

mve="mv $edir $pdir"
mvm="mv Makefile $pdir"

# check dir
if [ ! -d "$bdir" ];then
	mkdir $bdir
fi

if [ -d "$pdir$edir" ]; then
  rm -rf $pdir$edir
fi

rm -f Makefile

$cmd
status=$?

if [ $status -eq 0 ];then
  rm -rf *
	$run
	$mve
fi
